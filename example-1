from pathlib import Path
import sys

count = 0
if len(sys.argv) < 2:
    print("Usage: python3 log_check.py <log_file>")
    sys.exit(1)
    path = Path(sys.argv[1])
    if path.is_file():
        with open(path,"r") as file:
            for line in file:
                if "ERROR" in line:
                    count += 1
    print("Total errors:", count)


